<Window x:Class="MiniRacingHUD.NewThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniRacingHUD"
        xmlns:res="clr-namespace:MiniRacingHUD.Properties"
        xmlns:loc="clr-namespace:MiniRacingHUD"
        Title="{loc:Loc WindowTitle_NewTheme}"
        MinWidth="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <local:BaseDialogWindow x:Name="shell" Title="{loc:Loc WindowTitle_NewTheme}">
        <local:BaseDialogWindow.BodyContent>
            <StackPanel>
                <local:InputField
                                  MaxLength="40"
                                  ToolTipText="{loc:Loc Tooltip_NewThemeName}"
                                  Margin="32,16,32,0"/>
                <TextBlock Tag="ErrorText"
                           FontSize="10"
                           Foreground="#777777"
                           Visibility="Collapsed"
                           Margin="32,4,32,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="32,12,32,16">
                    <Button Content="{loc:Loc Button_Create}"
                            Style="{StaticResource GreenButton}"
                            Width="120" Height="32"
                            Click="CreateButton_Click"/>
                    <Border Width="16"/>
                    <Button Content="{loc:Loc Dialog_ButtonCancel}"
                            Style="{StaticResource GrayButton}"
                            Width="120" Height="32"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </local:BaseDialogWindow.BodyContent>
    </local:BaseDialogWindow>
</Window>
