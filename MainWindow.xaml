<Window x:Class="MiniRacingHUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniRacingHUD"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:res="clr-namespace:MiniRacingHUD.Properties"
        xmlns:loc="clr-namespace:MiniRacingHUD"
        mc:Ignorable="d"
        Title="Mini Racing HUD"
        Icon="pack://application:,,,/MiniRacingHUD.ico"
        Height="960" Width="1260" MinWidth="1140" MinHeight="540"
        Background="{StaticResource BackgroundBrush}"
        PreviewMouseDown="Window_PreviewMouseDown"
        Loaded="Window_Loaded">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#081418"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                MaxHeight="400">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#000" Opacity="0.4"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid x:Name="rootGrid" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Title -->
            <RowDefinition Height="Auto"/>  <!-- 1: Controls Top -->
            <RowDefinition Height="Auto"/>  <!-- 2: Controls Bottom -->
            <RowDefinition Height="*"/>      <!-- 3: WebView2 -->
            <RowDefinition Height="Auto"/>  <!-- 4: Status -->
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Height="36"
                WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title (draggable area) -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="12,0,16,0"
                            WindowChrome.IsHitTestVisibleInChrome="False">
                    <Ellipse Width="6" Height="6" 
                             Fill="{StaticResource AccentBrush}" 
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="titleText" Text="Mini Racing HUD" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButton}"
                            Content="─"
                            Click="MinimizeWindow"
                             ToolTip="{loc:Loc Tooltip_Minimize}"
                            Height="Auto" VerticalAlignment="Stretch"/>
                    <Button x:Name="maximizeBtn" Style="{StaticResource WindowControlButton}"
                            Content="☐"
                            Click="MaximizeWindow"
                            ToolTip="{loc:Loc Tooltip_Maximize}"
                            Height="Auto" VerticalAlignment="Stretch"/>
                    <Button Style="{StaticResource CloseButton}"
                            Content="✕"
                            Click="CloseWindow"
                            ToolTip="{loc:Loc Tooltip_Close}"
                            Height="Auto" VerticalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controls Bar - Top Row -->
        <Border Grid.Row="1" 
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,4,6,4"
                MinHeight="32"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="diModeToggle"
                                  Style="{StaticResource MinimalToggle}"
                                  Content="{loc:Loc Toggle_DirectInput}"
                                  ToolTip="{loc:Loc Tooltip_DirectInput}"
                                  Checked="DiModeToggle_Checked"
                                  Unchecked="DiModeToggle_Unchecked"
                                  Margin="0,0,8,0"/>
                    <ToggleButton x:Name="telemetryToggle" 
                                  Style="{StaticResource MinimalToggle}"
                                  Content="{loc:Loc Toggle_Telemetry}"
                                  Click="TelemetryToggle_Click"
                                  ToolTip="{loc:Loc Tooltip_Telemetry}"
                                  Margin="0,0,8,0"/>
                    <local:InputField x:Name="udpPortInput" Label="{loc:Loc Status_UdpPortLabel_Udp}" InputWidth="35"
                                      TextAlignment="Center" ToolTipText="{loc:Loc Tooltip_UdpPort}"
                                      Margin="0,0,8,0"/>
                    <Button x:Name="udpDataBtn"
                            Style="{StaticResource ToolbarIconButton}"
                            Click="ShowUDPData_Click"
                            ToolTip="{loc:Loc Tooltip_ShowTelemetry}"
                            Margin="0,0,8,0">
                        <Path Data="M7,6H23a1,1,0,0,0,0-2H7A1,1,0,0,0,7,6Z M23,11H7a1,1,0,0,0,0,2H23a1,1,0,0,0,0-2Z M23,18H7a1,1,0,0,0,0,2H23a1,1,0,0,0,0-2Z M 2,3 A 2,2 0 1,1 2,7 A 2,2 0 1,1 2,3 Z M 2,10 A 2,2 0 1,1 2,14 A 2,2 0 1,1 2,10 Z M 2,17 A 2,2 0 1,1 2,21 A 2,2 0 1,1 2,17 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="colorEditorBtn" Style="{StaticResource ToolbarIconButton}"
                            Click="OpenColorEditor_Click"
                            ToolTip="{loc:Loc Tooltip_ColorEditor}" Visibility="Collapsed" Margin="0,0,8,0">
                        <Path Data="M17.115,8.05A1.5,1.5,0,1,0,18.95,9.115,1.5,1.5,0,0,0,17.115,8.05Z M12.115,5.05A1.5,1.5,0,1,0,13.95,6.115,1.5,1.5,0,0,0,12.115,5.05Z M7.115,8.05A1.5,1.5,0,1,0,8.95,9.115,1.5,1.5,0,0,0,7.115,8.05Z M7.115,14.05A1.5,1.5,0,1,0,8.95,15.115,1.5,1.5,0,0,0,7.115,14.05Z M12.5.007A12,12,0,0,0,.083,12a12.014,12.014,0,0,0,12,12c.338,0,.67-.022,1-.05a1,1,0,0,0,.916-1l-.032-3.588A3.567,3.567,0,0,1,20.057,16.8l.1.1a1.912,1.912,0,0,0,1.769.521,1.888,1.888,0,0,0,1.377-1.177A11.924,11.924,0,0,0,24.08,11.7,12.155,12.155,0,0,0,12.5.007Zm8.982,15.4-.014-.014a5.567,5.567,0,0,0-9.5,3.985L11.992,22a10,10,0,0,1,.09-20c.117,0,.235,0,.353.006a10.127,10.127,0,0,1,9.645,9.743A9.892,9.892,0,0,1,21.485,15.4Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Label_Language}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="langSelector"
                              Style="{StaticResource GameComboBox}"
                              MinWidth="80"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{loc:Loc Label_Game}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                    <ComboBox x:Name="gameSelector"
                              Style="{StaticResource GameComboBox}"
                              ToolTip="{loc:Loc Tooltip_GameSelect}"
                              SelectedIndex="0"
                                     Margin="0,0,8,0"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Height" Value="6"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock Text="{Binding DisplayName}" FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Rectangle Height="1" Margin="4,0" VerticalAlignment="Center"
                                               Stroke="#30363D" StrokeThickness="1" StrokeDashArray="2,2">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <Button Content="✕" Cursor="Hand"
                                            Background="Transparent" Height="Auto"
                                            VerticalAlignment="Stretch" HorizontalAlignment="Right"
                                            Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                            Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CloseButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustom}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton x:Name="autoDetectToggle"
                                  Style="{StaticResource MinimalToggle}"
                                  Content="{loc:Loc Toggle_AutoSelect}"
                                    ToolTip="{loc:Loc Tooltip_AutoDetect}"
                                    Margin="0,0,0,0"/>
                    <Button x:Name="themeEditorBtn" Style="{StaticResource ToolbarTextButton}"
                            Click="OpenThemeEditor_Click"
                            ToolTip="{loc:Loc Tooltip_ThemeEditor}" Margin="8,0,0,0"
                            Padding="6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="m19 0h-14a5.006 5.006 0 0 0 -5 5v5a7.009 7.009 0 0 0 7 7h2v4a3 3 0 0 0 6 0v-4h2a7.009 7.009 0 0 0 7-7v-5a5.006 5.006 0 0 0 -5-5zm-17 5a3 3 0 0 1 3-3h5v1a1 1 0 0 0 2 0v-1h2v3a1 1 0 0 0 2 0v-3h2v5a1 1 0 0 0 2 0v-4.816a3 3 0 0 1 2 2.816v5h-20zm15 10h-3a1 1 0 0 0 -1 1v5a1 1 0 0 1 -2 0v-5a1 1 0 0 0 -1-1h-3a5 5 0 0 1 -4.576-3h19.152a5 5 0 0 1 -4.576 3z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Button_ThemeEditor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controls Bar - Bottom Row -->
        <Border Grid.Row="2" 
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,4"
                MinHeight="32"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
                <!-- Right side -->
                <ToggleButton x:Name="minimizeOnStartToggle"
                              DockPanel.Dock="Right"
                              Style="{StaticResource MinimalToggle}"
                              Content="{loc:Loc Toggle_MinimizeOnStart}"
                               ToolTip="{loc:Loc Tooltip_MinimizeOnStart}"
                              Margin="8,0,0,0"/>
                <ToggleButton x:Name="trayToggle"
                              DockPanel.Dock="Right"
                              Style="{StaticResource MinimalToggle}"
                              Content="{loc:Loc Toggle_MinimizeToTray}"
                              ToolTip="{loc:Loc Tooltip_MinimizeToTray}"
                              Margin="20,0,0,0"/>

                <!-- Left side -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource ToolbarIconButton}"
                            Click="RefreshPage_Click"
                            ToolTip="{loc:Loc Tooltip_RefreshPage}"
                            Margin="0,0,8,0">
                        <Path Data="M12,2a10.032,10.032,0,0,1,7.122,3H16a1,1,0,0,0-1,1h0a1,1,0,0,0,1,1h4.143A1.858,1.858,0,0,0,22,5.143V1a1,1,0,0,0-1-1h0a1,1,0,0,0-1,1V3.078A11.981,11.981,0,0,0,.05,10.9a1.007,1.007,0,0,0,1,1.1h0a.982.982,0,0,0,.989-.878A10.014,10.014,0,0,1,12,2Z M22.951,12a.982.982,0,0,0-.989.878A9.986,9.986,0,0,1,4.878,19H8a1,1,0,0,0,1-1H9a1,1,0,0,0-1-1H3.857A1.856,1.856,0,0,0,2,18.857V23a1,1,0,0,0,1,1H3a1,1,0,0,0,1-1V20.922A11.981,11.981,0,0,0,23.95,13.1a1.007,1.007,0,0,0-1-1.1Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <local:InputField x:Name="htmlPathField"
                                      Grid.Column="1"
                                      Label="{loc:Loc Label_Html}"
                                      Cursor="Hand"
                                      Padding="6,3">
                        <local:InputField.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="{loc:Loc Menu_Change}" ToolTip="{loc:Loc Tooltip_MenuChange}" Click="BrowseHtmlPath_Click"/>
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="{loc:Loc Menu_CopyUrl}" ToolTip="{loc:Loc Tooltip_MenuCopyUrl}" Click="HtmlPathCopy_Click"/>
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="{loc:Loc Menu_Default}" ToolTip="{loc:Loc Tooltip_MenuDefault}" Click="HtmlPathDefault_Click"/>
                            </ContextMenu>
                        </local:InputField.ContextMenu>
                    </local:InputField>
                    <Button Grid.Column="2"
                            Style="{StaticResource ToolbarIconButton}"
                            Click="CopyPathBtn_Click"
                            ToolTip="{loc:Loc Tooltip_CopyUrl}"
                            Margin="8,0,4,0">
                        <Path Data="M15 20h-10a5.006 5.006 0 0 1 -5-5v-10a5.006 5.006 0 0 1 5-5h10a5.006 5.006 0 0 1 5 5v10a5.006 5.006 0 0 1 -5 5zm-10-18a3 3 0 0 0 -3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-10a3 3 0 0 0 -3-3zm19 17v-13a1 1 0 0 0 -2 0v13a3 3 0 0 1 -3 3h-13a1 1 0 0 0 0 2h13a5.006 5.006 0 0 0 5-5z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Grid.Column="3"
                            Style="{StaticResource ToolbarIconButton}"
                            Click="BrowseHtmlPath_Click"
                            ToolTip="{loc:Loc Tooltip_BrowseHtml}"
                            Margin="4,0,8,0">
                        <Path Data="M19,3H12.472a1.019,1.019,0,0,1-.447-.1L8.869,1.316A3.014,3.014,0,0,0,7.528,1H5A5.006,5.006,0,0,0,0,6V18a5.006,5.006,0,0,0,5,5H19a5.006,5.006,0,0,0,5-5V8A5.006,5.006,0,0,0,19,3ZM5,3H7.528a1.019,1.019,0,0,1,.447.1l3.156,1.579A3.014,3.014,0,0,0,12.472,5H19a3,3,0,0,1,2.779,1.882L2,6.994V6A3,3,0,0,1,5,3ZM19,21H5a3,3,0,0,1-3-3V8.994l20-.113V18A3,3,0,0,1,19,21Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <!-- WebView2 -->
        <Grid Grid.Row="3">
            <Border x:Name="loadingOverlay"
                    Background="#80000000"
                    Visibility="Visible"
                    Opacity="1">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Height="80">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="dot1"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.15"
                                                     Duration="0:0:0.8"
                                                     AutoReverse="True"
                                                     BeginTime="0:0:0.0"/>
                                    <DoubleAnimation Storyboard.TargetName="dot2"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.15"
                                                     Duration="0:0:0.8"
                                                     AutoReverse="True"
                                                     BeginTime="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetName="dot3"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.15"
                                                     Duration="0:0:0.8"
                                                     AutoReverse="True"
                                                     BeginTime="0:0:0.6"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <Ellipse x:Name="dot1" Width="8" Height="8"
                             Fill="{StaticResource AccentBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <Ellipse x:Name="dot2" Width="8" Height="8"
                             Fill="{StaticResource AccentBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <Ellipse x:Name="dot3" Width="8" Height="8"
                             Fill="{StaticResource AccentBrush}"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Overlay_Loading}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <wv2:WebView2 x:Name="webView" Visibility="Collapsed" Margin="5,0,5,0"/>
            <Border x:Name="htmlNotFoundOverlay"
                    Background="#80000000"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    MouseDown="HtmlNotFoundOverlay_MouseDown">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="🖹"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="48"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc Overlay_NoHtmlPath}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                                TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="statusText" 
                           Grid.Column="0" 
                           Style="{StaticResource StatusText}"
                               Margin="0,0,0,2"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="udpStatusConnection" 
                                Text="" 
                                Foreground="{StaticResource RedBrush}"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Margin="0,0,16,2"/>
                    <TextBlock x:Name="udpStatusMain" 
                                Text="{loc:Loc Status_SharedMemoryOff}" 
                                ToolTip="{loc:Loc Tooltip_UdpStatus}"
                                Foreground="{StaticResource RedBrush}"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Margin="0,0,16,2"/>
                    <TextBlock x:Name="wsStatus" 
                                Text="{loc:Loc Status_WsOff}" 
                                ToolTip="{loc:Loc Tooltip_WsStatus}"
                                Foreground="{StaticResource RedBrush}"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Margin="0,0,16,2"/>
                    <TextBlock x:Name="clientsCount" 
                                Text="{loc:Loc Status_Clients}" 
                                ToolTip="{loc:Loc Tooltip_ClientsCount}"
                                Style="{StaticResource StatusText}"
                                Margin="0,0,0,2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>