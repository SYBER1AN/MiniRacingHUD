<Window x:Class="MiniRacingHUD.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniRacingHUD"
        xmlns:loc="clr-namespace:MiniRacingHUD"
        Title="{loc:Loc Update_Title}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <local:BaseDialogWindow x:Name="shell" Title="{loc:Loc Update_Title}"/>
</Window>
