<UserControl x:Class="MiniRacingHUD.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MiniRacingHUD"
             xmlns:res="clr-namespace:MiniRacingHUD.Properties"
             xmlns:loc="clr-namespace:MiniRacingHUD"
                x:Name="pickerRoot"
                HorizontalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HSV поле -->
        <Grid Grid.Row="0">
            <Border x:Name="hsvBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid x:Name="hsvGrid" Margin="1" MouseDown="HsvGrid_MouseDown" MouseMove="HsvGrid_MouseMove" MouseUp="HsvGrid_MouseUp" Cursor="Cross">
                    <!-- Хью как фон (заполняет Grid) -->
                    <Rectangle x:Name="hueBg" RadiusX="3" RadiusY="3"/>
                    <!-- Saturation градиент (белый → прозрачный) -->
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FFFFFF"/>
                                <GradientStop Offset="1" Color="Transparent"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Value градиент (прозрачный → чёрный) -->
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="1" Color="#000000"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Border>
            <!-- Canvas-оверлей для маркера поверх рамки -->
            <Canvas IsHitTestVisible="False" Panel.ZIndex="1">
                <Ellipse x:Name="marker" Width="14" Height="14"
                         Stroke="White" StrokeThickness="2"
                         Fill="Transparent"
                         IsHitTestVisible="False"/>
            </Canvas>
        </Grid>

        <!-- Hue слайдер -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Height="16"
                Margin="0,5,0,0"
                MouseDown="HueSlider_MouseDown" MouseMove="HueSlider_MouseMove" MouseUp="HueSlider_MouseUp" Cursor="Hand">
            <Grid>
                <Rectangle x:Name="hueSlider" RadiusX="2" RadiusY="2" Margin="1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FF0000"/>
                            <GradientStop Offset="0.167" Color="#FFFF00"/>
                            <GradientStop Offset="0.333" Color="#00FF00"/>
                            <GradientStop Offset="0.5" Color="#00FFFF"/>
                            <GradientStop Offset="0.667" Color="#0000FF"/>
                            <GradientStop Offset="0.833" Color="#FF00FF"/>
                            <GradientStop Offset="1" Color="#FF0000"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas>
                    <Rectangle x:Name="hueThumb" Width="6" Height="14"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               RadiusX="2" RadiusY="2"
                               IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Saturation слайдер -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Height="16"
                Margin="0,5,0,0"
                MouseDown="SatSlider_MouseDown" MouseMove="SatSlider_MouseMove" MouseUp="SatSlider_MouseUp" Cursor="Hand">
            <Grid>
                <Rectangle x:Name="satSlider" RadiusX="2" RadiusY="2" Margin="1"/>
                <Canvas>
                    <Rectangle x:Name="satThumb" Width="6" Height="14"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               RadiusX="2" RadiusY="2"
                               IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Value/Brightness слайдер -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Height="16"
                Margin="0,5,0,0"
                MouseDown="ValSlider_MouseDown" MouseMove="ValSlider_MouseMove" MouseUp="ValSlider_MouseUp" Cursor="Hand">
            <Grid>
                <Rectangle x:Name="valSlider" RadiusX="2" RadiusY="2" Margin="1"/>
                <Canvas>
                    <Rectangle x:Name="valThumb" Width="6" Height="14"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               RadiusX="2" RadiusY="2"
                               IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Hex + Preview -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
            <Button x:Name="eyeDropBtn" Width="24" Height="24" ToolTip="{loc:Loc Tooltip_Eyedropper}">
                <Path Data="m23.112 5.165a3.025 3.025 0 0 0 0-4.279 3.094 3.094 0 0 0 -4.276 0l-2.436 2.438c-1.012 1.013-3.123.789-4.579-.013a2.6 2.6 0 0 0 -3.057 4.144l1.416 1.416-8.155 8.154a3.455 3.455 0 0 0 -.593 4.129l-1.139 1.139a1 1 0 0 0 0 1.414 1 1 0 0 0 1.414 0l1.139-1.139a3.455 3.455 0 0 0 4.129-.593l8.154-8.155 1.416 1.416a2.6 2.6 0 0 0 4.144-3.057c-.8-1.456-1.025-3.568-.013-4.58zm-17.552 15.396a1.536 1.536 0 0 1 -2.121 0 1.5 1.5 0 0 1 0-2.121l8.155-8.154 2.121 2.121zm13.7-14.376c-1.759 1.759-1.5 4.832-.325 6.958a.578.578 0 0 1 -.119.679.621.621 0 0 1 -.859 0l-7.779-7.781a.612.612 0 0 1 .428-1.041.522.522 0 0 1 .251.063c2.126 1.17 5.2 1.434 6.958-.325l2.439-2.438a1.045 1.045 0 0 1 1.446 0 1.024 1.024 0 0 1 0 1.449z"
                      Width="14" Height="14" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            </Button>
            <Rectangle x:Name="combinedPreview" Width="52" Height="24" RadiusX="4" RadiusY="4" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Cursor="Hand" ToolTip="{loc:Loc Tooltip_ColorPreview}" Margin="6,0,0,0"/>
            <local:InputField x:Name="hexField" Label="#" LabelFontSize="10" InputWidth="48"
                              TextAlignment="Center" Margin="6,0,0,0" ToolTipText="{loc:Loc Tooltip_HexCode}"/>
            <Button x:Name="copyHexBtn" Width="24" Height="24" Margin="8,0,0,0" ToolTip="{loc:Loc Tooltip_CopyHex}">
                <Path Data="M15 20h-10a5.006 5.006 0 0 1 -5-5v-10a5.006 5.006 0 0 1 5-5h10a5.006 5.006 0 0 1 5 5v10a5.006 5.006 0 0 1 -5 5zm-10-18a3 3 0 0 0 -3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-10a3 3 0 0 0 -3-3zm19 17v-13a1 1 0 0 0 -2 0v13a3 3 0 0 1 -3 3h-13a1 1 0 0 0 0 2h13a5.006 5.006 0 0 0 5-5z"
                      Width="14" Height="14" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            </Button>
            <Button x:Name="pasteHexBtn" Width="24" Height="24" Margin="4,0,0,0" ToolTip="{loc:Loc Tooltip_PasteHex}">
                <Path Data="M5,4h.18c.41,1.16,1.51,2,2.82,2h2c1.3,0,2.4-.84,2.82-2h.18c1.37,0,2.56,.92,2.91,2.25,.14,.54,.68,.86,1.22,.72,.53-.14,.86-.68,.72-1.22-.57-2.21-2.56-3.75-4.84-3.75h-.17c-.41-1.16-1.52-2-2.83-2h-2c-1.3,0-2.42,.84-2.83,2h-.17C2.24,2,0,4.24,0,7v12c0,2.76,2.24,5,5,5h3c.55,0,1-.45,1-1s-.45-1-1-1h-3c-1.65,0-3-1.35-3-3V7c0-1.65,1.35-3,3-3Zm3-2h2c.55,0,1,.45,1,1s-.45,1-1,1h-2c-.55,0-1-.45-1-1s.45-1,1-1Zm12,7h-5c-2.21,0-4,1.79-4,4v7c0,2.21,1.79,4,4,4h5c2.21,0,4-1.79,4-4v-7c0-2.21-1.79-4-4-4Zm2,11c0,1.1-.9,2-2,2h-5c-1.1,0-2-.9-2-2v-7c0-1.1,.9-2,2-2h5c1.1,0,2,.9,2,2v7Zm-2-6c0,.55-.45,1-1,1h-3c-.55,0-1-.45-1-1s.45-1,1-1h3c.55,0,1,.45,1,1Zm0,4c0,.55-.45,1-1,1h-3c-.55,0-1-.45-1-1s.45-1,1-1h3c.55,0,1,.45,1,1Z"
                      Width="14" Height="14" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            </Button>
        </StackPanel>

        <Button x:Name="resetOldBtn" Grid.Row="5" Content="{loc:Loc Button_Reset}" Height="32" Width="120" Margin="0,12,0,0"
                HorizontalAlignment="Center"/>
    </Grid>
</UserControl>
